# ============================================================
#  墨韵博客 · 前端环境变量
#  修改后需重启开发服务器（npm start）才会生效
# ============================================================

# 后端接口地址
REACT_APP_BASE_URL=http://127.0.0.1:8000

# 站点名称（同时用于页面标题与导航栏 Logo）
REACT_APP_SITE_NAME=墨韵博客

# 站点标语
REACT_APP_SITE_SLOGAN=以代码为骨，以文字为韵
